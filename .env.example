PORT=3000

# ── INSTANCE DE TEST ──────────────────────────────────────────
# Pour tester une nouvelle version sans toucher à celle qui tourne :
#   npm run test:seed   (copie data/ vers data-test/, une seule fois)
#   npm run test:run    (démarre sur le port 3001 avec data-test/)
# Ne rien mettre ici : ces valeurs se passent en ligne de commande, sinon
# elles s'appliqueraient aussi à la prod.
#
# DATA_DIR : répertoire des données. Défaut : ./data
# HOST     : adresse d'écoute. Défaut 0.0.0.0 (toutes les interfaces, donc
#            joignable depuis le réseau). 127.0.0.1 = accès local seulement.

# ── Secrets ───────────────────────────────────────────────────
# On stocke le CONDENSÉ bcrypt, jamais le mot de passe en clair.
# Générer une valeur :  node scripts/hash-password.js
#
# Accès Configuration / Audit / Ops Review / Data Quality / Approbations
CONFIG_PW_HASH=

# Accès Absences (données RH) — secret distinct de l'admin
ABSENCE_PW_HASH=

# Repli de dépannage : si *_PW_HASH est absent, *_PW (en clair) est
# accepté et haché au démarrage. À éviter en production — le mot de passe
# resterait lisible dans ce fichier.
# CONFIG_PW=
# ABSENCE_PW=

# ── Sauvegardes ───────────────────────────────────────────────
# Nombre de copies quotidiennes de data/ conservées dans data/backups/.
# Défaut : 14. Mettre 0 pour désactiver les sauvegardes automatiques.
# BACKUP_RETENTION_DAYS=14

# ── JOURNAL DES REQUÊTES ──────────────────────────────────────
# Une ligne par écriture (POST/PUT/PATCH/DELETE) et par erreur. Les 404
# provoquées par le navigateur (sondes DevTools, fichiers .map) ne sont
# pas tracées. Mettre 0 pour couper le journal ; les erreurs serveur
# restent affichées dans tous les cas.
# LOG_HTTP=1

# ── CORS ──────────────────────────────────────────────────────
# Les origines du réseau privé (10.x, 172.16-31.x, 192.168.x, localhost,
# *.local) sont acceptées d'office. Ajouter ici les origines
# supplémentaires à autoriser, séparées par des virgules.
# CORS_ORIGINS=http://serveur-pearl:8080

# ── DIFFUSION PAR MAIL ────────────────────────────────────────
# Raccourci : évite de ressaisir le mot de passe dans la page Admin →
# Diffusion après une réinstallation. Ce qui est saisi dans la page reste
# prioritaire sur ces valeurs.
#
# Gmail exige un MOT DE PASSE D'APPLICATION (16 caractères), pas le mot
# de passe du compte : myaccount.google.com → Sécurité → Mots de passe
# des applications. À saisir sans les espaces.
# SMTP_USER=adresse@gmail.com
# SMTP_FROM=adresse@gmail.com
# SMTP_PASS=

# ── ASSISTANT IA (Admin › Assistant IA) ───────────────────────
# La clé se saisit dans la page (gardée dans data/ai.secret, hors git).
# AI_API_KEY ici la remplace, mais ce .env est versionné : préférer la page.
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=glm-5.3
# Proxy : se règle dans la page (Automatique lit le proxy de Windows).
# AI_PROXY ici l'impose et masque le réglage de la page :
# AI_PROXY=http://proxy.entreprise:8080
# Certificats : le magasin du système est lu (Node 22.15+). Sur une
# version plus ancienne, avec un proxy qui inspecte le HTTPS :
# NODE_EXTRA_CA_CERTS=/chemin/ca-entreprise.pem
# Autoriser http:// (la clé circule alors en clair) :
# AI_ALLOW_HTTP=1
