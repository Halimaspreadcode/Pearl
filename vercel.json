{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.js",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,server}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 6 * * *" }
  ]
}
