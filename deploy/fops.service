# Service systemd (Linux) : lance le watchdog au démarrage de la machine.
# Le watchdog relance le serveur s'il plante ou ne répond plus ; systemd
# relance le watchdog lui-même s'il venait à s'arrêter.
#
# Installation (adapter les deux chemins marqués ⚠) :
#   sudo cp deploy/fops.service /etc/systemd/system/fops.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fops
# Suivre :   systemctl status fops     journalctl -u fops -f
# Arrêter :  sudo systemctl stop fops

[Unit]
Description=FOps (EMOC tracker) — serveur sous watchdog
After=network.target

[Service]
Type=simple
# ⚠ dossier du projet
WorkingDirectory=/opt/emoc-tracker
# ⚠ chemin de node : `which node`
ExecStart=/usr/bin/node server/watchdog.js
Environment=WATCHDOG_SUPERVISED=1
Restart=always
RestartSec=5
# SIGTERM : le watchdog arrête le serveur proprement (écritures terminées).
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
