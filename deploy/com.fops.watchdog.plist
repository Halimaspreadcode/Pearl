<?xml version="1.0" encoding="UTF-8"?>
<!--
  Agent launchd (macOS) : lance le watchdog à l'ouverture de session et le
  relance s'il s'arrête. Le watchdog relance le serveur lui-même.

  Installation (adapter les chemins marqués ⚠) :
    cp deploy/com.fops.watchdog.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.fops.watchdog.plist
  Arrêter :
    launchctl unload -w ~/Library/LaunchAgents/com.fops.watchdog.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fops.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <!-- ⚠ chemin de node : `which node` -->
    <string>/usr/local/bin/node</string>
    <string>server/watchdog.js</string>
  </array>
  <!-- ⚠ dossier du projet -->
  <key>WorkingDirectory</key>
  <string>/Users/VOTRE_NOM/emoc-tracker</string>
  <key>EnvironmentVariables</key>
  <dict><key>WATCHDOG_SUPERVISED</key><string>1</string></dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/fops.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fops.err.log</string>
</dict>
</plist>
