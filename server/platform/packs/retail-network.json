        "format": "currency",
        "unit": "€",
        "agg": "avg",
        "freq": "week",
        "better": "up"
      },
      {
        "label": "Fréquentation",
        "format": "number",
        "agg": "sum",
        "freq": "week",
        "better": "up"
      },
      {
        "label": "Satisfaction client",
        "format": "percent",
        "unit": "%",
        "agg": "avg",
        "freq": "month",
        "better": "up",
